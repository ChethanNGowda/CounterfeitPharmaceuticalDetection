# Counterfeit Pharmaceutical Detection - Environment Configuration
# Duplicate this file as '.env' and adjust values for your environment.

# Base host & port for FastAPI backend
API_HOST=0.0.0.0
API_PORT=8000

# Ollama Visual Verification Configuration
# Base URL where Ollama daemon is running
OLLAMA_BASE_URL=http://localhost:11434

# Vision model for physical appearance and packaging triage. Qwen 3.5 Vision
# is preferred because the installed qwen3-vl template can return reasoning
# without a user-facing answer on some Ollama builds.
OLLAMA_VISION_MODEL=qwen3.5:4b

# Network timeout in seconds for Ollama requests
OLLAMA_TIMEOUT=180.0

# Default model architecture for primary screening: efficientnet_b0, mobilenet_v3_large, baseline_cnn, goldformer
DEFAULT_MODEL=efficientnet_b0

# Confidence threshold (0.0 - 1.0) below which manual physical review is required
DEFAULT_CONFIDENCE_THRESHOLD=0.70
