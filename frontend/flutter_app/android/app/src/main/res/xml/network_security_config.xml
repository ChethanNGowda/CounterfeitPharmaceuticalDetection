<?xml version="1.0" encoding="utf-8"?>
<!--
  Network Security Configuration for PharmaAssist (debug/development builds).

  Rationale: The backend FastAPI server is accessed over plain HTTP during
  development (no TLS cert available for LAN IPs). Rather than enabling
  usesCleartextTraffic globally, we restrict cleartext to known development
  domains only, so production HTTPS endpoints remain protected.

  Permitted cleartext hosts:
    - 10.0.2.2       Android emulator loopback → host machine
    - 127.0.0.1      Physical-device localhost (USB forwarding / same-machine)
    - 10.152.189.x   Default dev LAN subnet used in settings screen
    - 192.168.x.x    Common home/office LAN subnets

  In production, remove this file and use HTTPS for all backend traffic.
-->
<network-security-config>
    <!-- Allow cleartext traffic only to known development hosts -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Android emulator → host loopback -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- USB-forwarded / same-machine loopback -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <!-- Common LAN subnets (development only) -->
        <domain includeSubdomains="false">10.152.189.167</domain>
    </domain-config>

    <!-- Everything else defaults to HTTPS-only (secure by default) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
